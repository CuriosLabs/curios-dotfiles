{
  "$schema": "https://opencode.ai/config.json",
  // Settings
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "fd *": "allow",
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "grep *": "allow",
      "ls *": "allow",
      "rm *": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "webfetch": "allow"
  },
  "autoupdate": false,
  // LLMs Providers - Adjust to your real configuration
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        // Adjust to your LM Studio configuration
        "nvidia/nemotron-3-nano-4b": {
          "name": "Nemotron-3 Nano 4b (local)"
        },
        "qwen/qwen3.5-9b": {
          "name": "Qwen3.5 9b (local)"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        // Adjust to your Ollama downloaded models
        "qwen2.5-coder:3b": {
          "name": "Qwen2.5 Coder 3b"
        }
      }
    }
  }
}
