#!/usr/bin/env bash

# Install script for CuriOS dotfiles as an NixOS package.
# This script install the dotfiles from https://github.com/CuriosLabs/curios-dotfiles
# Made for Linux and a COSMIC desktop environment.

set -eu

#------------- Variables init
readonly SCRIPT_VERSION="0.41.0"
VERBOSE=0
LOCALE_KEYBOARD="us"
SET_LOCALE=0
SELECTED_THEME="One Dark"
SCRIPT_PATH="$(dirname "$0")"
readonly THEME_CONFIG_FILE="$HOME/.curios/themes/themes.json"
PRINT_INFO=0
UPDATE_THEME=0
UPGRADE_THEME=0
LIST_THEMES=0
EXTRACTED_SOURCE_PATH=""
#------------- Colors -------------#
readonly RED="\033[31;1m"      # Red and bold
readonly GREEN="\033[32;1m"    # Green and bold
readonly GREY="\033[37;1m"     # Grey and bold
readonly YELLOW="\033[33;1;3m" # Yellow, bold and italic
readonly NC="\033[0m"          # No Color

#------------- Print help function
usage() {
  echo -e "
${GREY}USAGE:${NC}
  curios-dotfiles [options] <directory>

  Where:
    directory: A valid directory to copy the dotfiles into, such as '$HOME' or '/etc/skel'.

${GREY}OPTIONS:${NC}
  ${GREY}-h, --help${NC}         Print this message.
  ${GREY}--lang LANG${NC}        Set the COSMIC keyboard layout. Default: 'us'.
  ${GREY}--list${NC}             List themes from the theme config and exit.
  ${GREY}--themes THEME${NC}     Apply a theme from the theme config, for example 'One Dark'.
  ${GREY}--info${NC}             Print information about the Git repository used to source dotfiles and themes.
  ${GREY}--upgrade${NC}          Upgrade dotfiles and themes from their Git repository.
  ${GREY}-v, --verbose${NC}      Print more information.
  ${GREY}--version${NC}          Print the version number and exit.

  Themes are read from ${THEME_CONFIG_FILE}.

${GREY}EXAMPLES:${NC}
    List available themes:
      ${GREY}curios-dotfiles --list${NC}
    Apply the "One Dark" theme to your home directory:
      ${GREY}curios-dotfiles --themes \"One Dark\" $HOME ${NC}
    Upgrade dotfiles and themes from Git and install them into your home directory:
      ${GREY}curios-dotfiles --upgrade $HOME ${NC}
    Print information about the dotfiles Git repository:
      ${GREY}curios-dotfiles --info${NC}
    Set the COSMIC keyboard layout to French:
      ${GREY}curios-dotfiles --lang fr $HOME ${NC}
    Install as a skeleton for future users' home directories:
      ${GREY}sudo curios-dotfiles /etc/skel/${NC}
"
  exit
}

#------------- Expand a leading ~/ against a root directory
expand_tilde() {
  local path="$1"
  local root="${2%/}"
  local tilde
  tilde=$(printf '~')
  if [ "${path#"$tilde"/}" != "$path" ]; then
    printf '%s/%s\n' "$root" "${path#"$tilde"/}"
  elif [ "$path" = "$tilde" ]; then
    printf '%s\n' "$root"
  else
    printf '%s\n' "$path"
  fi
}

#------------- Require theme config
require_theme_config() {
  if ! command -v jq >/dev/null 2>&1; then
    echo -e "${RED}jq is required to read ${THEME_CONFIG_FILE}${NC}" >&2
    exit 1
  fi
  if [ ! -f "$THEME_CONFIG_FILE" ]; then
    echo -e "${RED}Theme file not found: ${THEME_CONFIG_FILE}${NC}" >&2
    exit 1
  fi
}

#------------- Print Git repo informations
print_info() {
  local git_repo
  local git_branch
  local git_rev
  git_repo=$(nix-instantiate --eval --raw --expr '(import <nixpkgs/nixos> {}).config.curios.core.dotfiles.url')
  git_branch=$(nix-instantiate --eval --raw --expr '(import <nixpkgs/nixos> {}).config.curios.core.dotfiles.branch')
  git_rev=$(nix-instantiate --eval --raw --expr '(import <nixpkgs/nixos> {}).config.curios.core.dotfiles.revision')
  echo -e "${GREEN}Git source:${NC} $git_repo ${GREEN}on branch:${NC} $git_branch ${GREEN}at revision:${NC} $git_rev"
}

#------------- Upgrade dotfiles from Git repo
verify_commit_signature() {
  local repo="$1"
  if ! git -C "$repo" -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="/etc/curios/allowed_signers" verify-commit HEAD; then
    echo -e "${RED}Refusing update: Git commit signature is invalid.${NC}" >&2
    exit 1
  fi
  echo -e "${GREEN}Git commit signature verified.${NC}"
}

upgrade_dotfiles() {
  local git_repo
  local git_branch
  local git_rev
  git_repo=$(nix-instantiate --eval --raw --expr '(import <nixpkgs/nixos> {}).config.curios.core.dotfiles.url')
  git_branch=$(nix-instantiate --eval --raw --expr '(import <nixpkgs/nixos> {}).config.curios.core.dotfiles.branch')
  git_rev=$(nix-instantiate --eval --raw --expr '(import <nixpkgs/nixos> {}).config.curios.core.dotfiles.revision')

  EXTRACTED_SOURCE_PATH=$(mktemp -d -t curios-dotfiles-XXXXXX)
  trap 'rm -rf -- "$EXTRACTED_SOURCE_PATH"' EXIT

  echo -e "${GREEN}Downloading Git sources...${NC}"
  git clone --branch "${git_branch}" --single-branch --depth 1 "${git_repo}" "${EXTRACTED_SOURCE_PATH}"
  echo "Dotfiles extracted to ${EXTRACTED_SOURCE_PATH}"
  #verify_commit_signature "${EXTRACTED_SOURCE_PATH}"

  # Checking extracted source
  if [ ! -f "${EXTRACTED_SOURCE_PATH}"/themes/themes.json ] || [ ! -d "${EXTRACTED_SOURCE_PATH}/themes/" ] || [ ! -d "${EXTRACTED_SOURCE_PATH}/dotfiles/" ] || [ ! -d "${EXTRACTED_SOURCE_PATH}/wallpapers/" ]; then
    echo -e "${RED}Not a valid CuriOS theme!${NC}"
    exit 1
  fi

  # Copying dotfiles to INSTALL_DIR
  mkdir -p "$INSTALL_DIR/.curios/themes" "$INSTALL_DIR/.curios/wallpapers"
  cp -a "${EXTRACTED_SOURCE_PATH}/dotfiles/." "$INSTALL_DIR/"
  cp -a "${EXTRACTED_SOURCE_PATH}/themes/." "$INSTALL_DIR/.curios/themes/"
  while IFS= read -r -d '' wallpaper; do
    mkdir -p "$INSTALL_DIR/.curios/wallpapers/$(dirname -- "$wallpaper")"
    cp -a "${EXTRACTED_SOURCE_PATH}/wallpapers/${wallpaper}" "$INSTALL_DIR/.curios/wallpapers/${wallpaper}"
  done < <(find "${EXTRACTED_SOURCE_PATH}/wallpapers" -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) -printf '%P\0')
}

#------------- List themes from THEME_CONFIG_FILE
list_themes() {
  require_theme_config
  if ! jq -e '.themes | type == "object"' "$THEME_CONFIG_FILE" >/dev/null; then
    echo -e "${RED}No themes found in ${THEME_CONFIG_FILE}${NC}" >&2
    exit 1
  fi
  jq -r '.themes | keys_unsorted[]' "$THEME_CONFIG_FILE"
}

#------------- Apply theme function
apply_theme() {
  local theme_name="$1"
  local install_dir="$2"
  local alacritty_theme=""
  local ghostty_theme=""
  local zed_theme=""
  local color_theme=""
  local nvim_theme=""
  local cosmic_theme=""
  local wallpapers=""
  local theme_data=""
  local wallpaper_file="$install_dir/.config/cosmic/com.system76.CosmicSettings.Wallpaper/v1/current-folder"
  local background_file="$install_dir/.config/cosmic/com.system76.CosmicBackground/v1/all"
  local bravethemespolicyfile="/etc/brave/policies/managed/themes.json"

  require_theme_config

  if ! jq -e --arg name "$theme_name" '.themes | has($name)' "$THEME_CONFIG_FILE" >/dev/null; then
    echo -e "${RED}Unknown theme: ${theme_name}${NC}" >&2
    echo -e "${YELLOW}Use --list to see available themes.${NC}" >&2
    exit 1
  fi

  theme_data=$(jq -r --arg name "$theme_name" '
    .themes[$name]
    | [
        (.alacritty_theme // ""),
        (.ghostty_theme // ""),
        (.zed // ""),
        (.color // ""),
        (.nvim // ""),
        (.cosmic_theme // ""),
        (.wallpapers // "")
      ]
    | @tsv
  ' "$THEME_CONFIG_FILE")
  IFS=$'\t' read -r alacritty_theme ghostty_theme zed_theme color_theme nvim_theme cosmic_theme wallpapers <<<"$theme_data"

  alacritty_theme=$(expand_tilde "$alacritty_theme" "$install_dir")
  ghostty_theme=$(expand_tilde "$ghostty_theme" "$install_dir")
  cosmic_theme=$(expand_tilde "$cosmic_theme" "$HOME")
  wallpapers=$(expand_tilde "$wallpapers" "$install_dir")

  printf "\e[32m Applying theme: %s...\e[0m\n" "$theme_name"

  # 1. Alacritty
  if [ -n "$alacritty_theme" ] && [ -f "$alacritty_theme" ]; then
    cp "$alacritty_theme" "$install_dir/.config/alacritty/alacritty.toml"
  fi

  # 2. Ghostty
  if [ -n "$ghostty_theme" ] && [ -f "$ghostty_theme" ]; then
    cp "$ghostty_theme" "$install_dir/.config/ghostty/theme.config"
  fi

  # 3. Neovim
  if [ -n "$nvim_theme" ] && [ -f "$install_dir/.config/nvim/lua/plugins/colorschemes.lua" ]; then
    sed -i "s/colorscheme = \".*\"/colorscheme = \"$nvim_theme\"/" "$install_dir/.config/nvim/lua/plugins/colorschemes.lua"
  fi

  # 4. Zed
  if [ -n "$zed_theme" ] && [ -f "$install_dir/.config/zed/settings.json" ]; then
    if [[ "$zed_theme" == *[Ll]ight* ]]; then
      sed -i "s/\"mode\": \".*\"/\"mode\": \"light\"/" "$install_dir/.config/zed/settings.json"
      sed -i "s/\"light\": \".*\"/\"light\": \"$zed_theme\"/" "$install_dir/.config/zed/settings.json"
    else
      sed -i "s/\"mode\": \".*\"/\"mode\": \"dark\"/" "$install_dir/.config/zed/settings.json"
      sed -i "s/\"dark\": \".*\"/\"dark\": \"$zed_theme\"/" "$install_dir/.config/zed/settings.json"
    fi
  fi

  # 5. Brave Browser (Manual Reference)
  if [ -n "$color_theme" ]; then
    if [ ! -f "$bravethemespolicyfile" ]; then
      sudo mkdir -p "$(dirname "$bravethemespolicyfile")"
      sudo touch "$bravethemespolicyfile"
      sudo chown 1000:100 "$bravethemespolicyfile"
    fi
    jq -n --arg color "$color_theme" '{ "BrowserThemeColor": $color }' >"$bravethemespolicyfile"
  fi

  # 6. COSMIC desktop
  if [ -n "$cosmic_theme" ] && command -v cosmic-settings >/dev/null 2>&1; then
    cosmic-settings appearance import "$cosmic_theme"
  fi

  # 7. COSMIC wallpapers
  if [ -n "$wallpapers" ]; then
    mkdir -p "$(dirname "$wallpaper_file")"
    printf 'Some("%s")\n' "$wallpapers" >"$wallpaper_file"
    if [ -f "$background_file" ]; then
      sed -i "s|source: Path(\".*\")|source: Path(\"$wallpapers\")|" "$background_file"
    fi
  fi
}

#------------- Scripts arguments parse options
ARGS=$(getopt --longoptions="verbose,version,help,lang:,list,themes:,info,upgrade" --name "$0" --options ":hv" -- "$@")
if [ $# -lt 1 ]; then
  usage
fi

INSTALL_DIR="${!#}"

eval set -- "$ARGS"

while true; do
  case "$1" in
  -v | --verbose)
    VERBOSE=1
    shift
    ;;
  -h | --help)
    usage
    ;;
  --lang)
    SET_LOCALE=1
    LOCALE_KEYBOARD="$2"
    shift 2
    ;;
  --list)
    LIST_THEMES=1
    shift
    ;;
  --themes)
    UPDATE_THEME=1
    SELECTED_THEME="$2"
    shift 2
    ;;
  --info)
    PRINT_INFO=1
    shift
    ;;
  --upgrade)
    UPGRADE_THEME=1
    shift
    ;;
  --version)
    echo "$SCRIPT_VERSION"
    exit 0
    ;;
  --)
    shift
    break
    ;;
  *)
    break
    ;;
  esac
done

if [ $VERBOSE -eq 1 ]; then
  echo "path: $SCRIPT_PATH"
  echo "<directory>: $INSTALL_DIR"
  echo "--lang: $LOCALE_KEYBOARD"
  echo "--themes: $SELECTED_THEME"
  echo "--info: $PRINT_INFO"
  echo "--upgrade: $UPGRADE_THEME"
  echo "--verbose: $VERBOSE"
fi

if [ "$LIST_THEMES" -eq 1 ]; then
  list_themes
  exit 0
fi

if [ "$PRINT_INFO" -eq 1 ]; then
  print_info
  exit 0
fi

#------------- Check <directory>
if [ ! -d "$INSTALL_DIR" ]; then
  printf "\e[31mDirectory argument is invalid!\e[0m\n"
  exit 2
fi

if [ "$UPGRADE_THEME" -eq 1 ]; then
  upgrade_dotfiles
fi

#------------- Update COSMIC keyboard layout
if [ "$SET_LOCALE" -eq 1 ]; then
  cosmic_locale_file="$INSTALL_DIR"/.config/cosmic/com.system76.CosmicComp/v1/xkb_config
  if [ ! -f "$cosmic_locale_file" ]; then
    echo -e "${RED}Locale file not found!${NC}"
    exit 1
  fi
  sed "s/layout: \".*/layout: \"${LOCALE_KEYBOARD}\",/g" -i "$INSTALL_DIR"/.config/cosmic/com.system76.CosmicComp/v1/xkb_config
fi

#------------- Apply selected theme
if [ "$UPDATE_THEME" -eq 1 ]; then
  apply_theme "$SELECTED_THEME" "$INSTALL_DIR"
fi

echo -e "${GREEN}Done.${NC}"
