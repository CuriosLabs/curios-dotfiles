#!/usr/bin/env bash

# Install script for CuriOS dotfiles as an NixOS package.
# This script install the dotfiles from https://github.com/CuriosLabs/curios-dotfiles
# Made for Linux and a COSMIC desktop environment.

set -eu

#------------- Variables init
readonly SCRIPT_VERSION="0.28.2"
VERBOSE=0
LOCALE_KEYBOARD="us"
SELECTED_THEME="One-Dark"
readonly THEMES_LIST=("Catppuccin-Macchiato" "Everforest-Medium" "Gruvbox-Dark" "Hackers-Green" "Kanagawa" "Nord-Dark" "Nord-Light" "One-Dark" "Tokyonight")
SCRIPT_PATH="$(dirname "$0")"

#------------- Print help function
usage() {
  echo -e "
Usage: curios-dotfiles [options] <directory>
  Where,
    directory: Valid directory to copy the dotfiles into, like '/home/<user>' or '/etc/skel'."

  cat <<EOF

  Options:
     -h, --help         Print this message.
     --lang LANG        Preset COSMIC keyboard layout, 'us' by default.
     --themes THEME     Preset theme, 'One-Dark' by default. Available: ${THEMES_LIST[*]}.
     -v, --verbose      Print more information.
     --version          Print version number and exit.

  Examples:
    Install dotfiles into home directory of user 'nixos' with French keyboard:
      curios-dotfiles --lang fr --themes One-Dark /home/nixos/
    Install as a skeleton for future user home directory:
      curios-dotfiles /etc/skel/
EOF
  exit
}

#------------- Apply theme function
apply_theme() {
  local theme_name="$1"
  local install_dir="$2"
  local color_theme=""
  local nvim_theme=""
  local tui_theme=""
  local bravethemespolicyfile="/etc/brave/policies/managed/themes.json"

  printf "\e[32m Applying theme: %s...\e[0m\n" "$theme_name"

  case "$theme_name" in
  Catppuccin-Macchiato)
    color_theme="#24273a"
    nvim_theme="catppuccin-macchiato"
    tui_theme="catppuccin-macchiato"
    ;;
  Everforest-Medium)
    color_theme="#2d353b"
    nvim_theme="everforest"
    tui_theme="everforest"
    ;;
  Gruvbox-Dark)
    color_theme="#282828"
    nvim_theme="gruvbox"
    tui_theme="gruvbox"
    ;;
  Hackers-Green)
    color_theme="#000000"
    nvim_theme="melange"
    tui_theme="matrix"
    ;;
  Kanagawa)
    color_theme="#1f1f28"
    nvim_theme="kanagawa"
    tui_theme="kanagawa"
    ;;
  Nord-Dark)
    color_theme="#2e3440"
    nvim_theme="nord"
    tui_theme="nord"
    ;;
  Nord-Light)
    color_theme="#eceff4"
    nvim_theme="nord"
    tui_theme="nord"
    ;;
  One-Dark)
    color_theme="#20252c"
    nvim_theme="onedark"
    tui_theme="one-dark"
    ;;
  Tokyonight)
    color_theme="#1a1b26"
    nvim_theme="tokyonight"
    tui_theme="tokyonight"
    ;;
  esac

  # 1. Alacritty
  if [ -f "$install_dir/.config/alacritty/$theme_name.toml" ]; then
    cp "$install_dir/.config/alacritty/$theme_name.toml" "$install_dir/.config/alacritty/alacritty.toml"
  fi

  # 1-bis. Ghostty
  if [ -f "$install_dir/.config/ghostty/$theme_name.config" ]; then
    cp "$install_dir/.config/ghostty/$theme_name.config" "$install_dir/.config/ghostty/theme.config"
  fi

  # 2. opencode tui.json
  if [ -f "$install_dir/.config/opencode/tui.json" ]; then
    sed -i "s/\"theme\": \".*\"/\"theme\": \"$tui_theme\"/" "$install_dir/.config/opencode/tui.json"
  fi

  # 3. Neovim
  if [ -n "$nvim_theme" ] && [ -f "$install_dir/.config/nvim/lua/plugins/colorschemes.lua" ]; then
    sed -i "s/colorscheme = \".*\"/colorscheme = \"$nvim_theme\"/" "$install_dir/.config/nvim/lua/plugins/colorschemes.lua"
  fi

  # 4. Zed
  if [ -f "$install_dir/.config/zed/settings.json" ]; then
    if [ "$theme_name" == "Nord-Light" ]; then
      sed -i "s/\"mode\": \".*\"/\"mode\": \"light\"/" "$install_dir/.config/zed/settings.json"
      sed -i "s/\"light\": \".*\"/\"light\": \"$theme_name\"/" "$install_dir/.config/zed/settings.json"
    else
      sed -i "s/\"mode\": \".*\"/\"mode\": \"dark\"/" "$install_dir/.config/zed/settings.json"
      sed -i "s/\"dark\": \".*\"/\"dark\": \"$theme_name\"/" "$install_dir/.config/zed/settings.json"
    fi
  fi

  # 5. Brave Browser (Manual Reference)
  if [ ! -f "$bravethemespolicyfile" ]; then
    sudo mkdir -p "$(dirname "$bravethemespolicyfile")"
    sudo touch "$bravethemespolicyfile"
    sudo chown 1000:100 "$bravethemespolicyfile"
  fi
  jq -n '{ "BrowserThemeColor": "'$color_theme'" }' >"$bravethemespolicyfile"

  # 6. COSMIC desktop
  if command -v cosmic-settings >/dev/null 2>&1; then
    cosmic-settings appearance import "/run/current-system/sw/share/themes/curios/$theme_name.ron"
  fi
}

#------------- Scripts arguments parse options
ARGS=$(getopt --longoptions="verbose,version,help,lang:,themes:" --name "$0" --options ":hv" -- "$@")
if [ $# -lt 1 ]; then
  usage
fi

INSTALL_DIR="${!#}"

eval set -- "$ARGS"

while true; do
  case "$1" in
  -v | --verbose)
    VERBOSE=1
    shift
    ;;
  -h | --help)
    usage
    ;;
  --lang)
    LOCALE_KEYBOARD="$2"
    shift 2
    ;;
  --themes)
    SELECTED_THEME="$2"
    # Validate theme
    valid_theme=0
    for t in "${THEMES_LIST[@]}"; do
      if [ "$t" == "$SELECTED_THEME" ]; then
        valid_theme=1
        break
      fi
    done
    if [ $valid_theme -eq 0 ]; then
      printf "\e[31mInvalid theme: %s\e[0m\n" "$SELECTED_THEME"
      echo "Available themes: ${THEMES_LIST[*]}"
      exit 2
    fi
    shift 2
    ;;
  --version)
    echo "$SCRIPT_VERSION"
    exit 0
    ;;
  --)
    shift
    break
    ;;
  *)
    break
    ;;
  esac
done

#------------- Check <directory>
if [ ! -d "$INSTALL_DIR" ]; then
  printf "\e[31mDirectory argument is invalid!\e[0m\n"
  exit 2
fi

printf "\e[32m Installing CuriosLabs dotfiles...\e[0m\n"

#------------- Check curios-dotfiles files
curios_dotfiles_path=$(nix-store --query --outputs "$(which curios-dotfiles)")
curios_dotfiles_path=$(realpath "$curios_dotfiles_path"/share)

if [ $VERBOSE -eq 1 ]; then
  echo "path: $SCRIPT_PATH"
  echo "curios_dotfiles_path: $curios_dotfiles_path"
  echo "<directory>: $INSTALL_DIR"
  echo "--lang: $LOCALE_KEYBOARD"
  echo "--themes: $SELECTED_THEME"
  echo "--verbose: $VERBOSE"
fi

if [ ! -d "$curios_dotfiles_path" ]; then
  printf "\e[31m curios-dotfiles package not found!\e[0m\n"
  exit 1
fi

#------------- Copying dotfiles into INSTALL_DIR
install -D -m 644 -t "$INSTALL_DIR" "$curios_dotfiles_path"/.npmrc
install -D -m 644 -t "$INSTALL_DIR" "$curios_dotfiles_path"/.zshrc

mkdir -p "$INSTALL_DIR"/.config/alacritty/
mkdir -p "$INSTALL_DIR"/.config/btop/
mkdir -p "$INSTALL_DIR"/.config/cosmic/
mkdir -p "$INSTALL_DIR"/.config/ghostty/
mkdir -p "$INSTALL_DIR"/.config/nvim/
mkdir -p "$INSTALL_DIR"/.config/opencode/plugins/
mkdir -p "$INSTALL_DIR"/.config/tmux/
mkdir -p "$INSTALL_DIR"/.config/zed/themes/
mkdir -p "$INSTALL_DIR"/.agents/skills/
mkdir -p "$INSTALL_DIR"/.gemini/agents/
mkdir -p "$INSTALL_DIR"/.gemini/hooks/
mkdir -p "$INSTALL_DIR"/.npm-packages/
mkdir -p "$INSTALL_DIR"/.pi/agent/extensions/

cp -r "$curios_dotfiles_path"/.config/alacritty/ "$INSTALL_DIR"/.config/
cp -r "$curios_dotfiles_path"/.config/btop/ "$INSTALL_DIR"/.config/
cp -r "$curios_dotfiles_path"/.config/cosmic/ "$INSTALL_DIR"/.config/
cp -r "$curios_dotfiles_path"/.config/ghostty/ "$INSTALL_DIR"/.config/
cp -r "$curios_dotfiles_path"/.config/nvim/ "$INSTALL_DIR"/.config/
cp -r "$curios_dotfiles_path"/.config/opencode/ "$INSTALL_DIR"/.config/
cp "$curios_dotfiles_path"/.config/tmux/tmux.conf "$INSTALL_DIR"/.config/tmux/tmux.conf
cp -ru "$curios_dotfiles_path"/.config/zed/ "$INSTALL_DIR"/.config/
cp -r "$curios_dotfiles_path"/.agents/skills/ "$INSTALL_DIR"/.agents/
cp -r "$curios_dotfiles_path"/.gemini/agents/ "$INSTALL_DIR"/.gemini/
cp -r "$curios_dotfiles_path"/.gemini/hooks/ "$INSTALL_DIR"/.gemini/
cp "$curios_dotfiles_path"/.gemini/settings.json "$INSTALL_DIR"/.gemini/settings.json
cp -r "$curios_dotfiles_path"/.pi/agent/ "$INSTALL_DIR"/.pi/

chmod -R u+w "$INSTALL_DIR"/.config/
chmod -R u+w "$INSTALL_DIR"/.agents/
chmod -R u+w "$INSTALL_DIR"/.gemini/
chmod -R u+w "$INSTALL_DIR"/.pi/

#------------- Update COSMIC keyboard layout
sed "s/layout: \".*/layout: \"${LOCALE_KEYBOARD}\",/g" -i "$INSTALL_DIR"/.config/cosmic/com.system76.CosmicComp/v1/xkb_config

#------------- Apply selected theme
if [ -n "$SELECTED_THEME" ]; then
  apply_theme "$SELECTED_THEME" "$INSTALL_DIR"
fi

printf "\e[32mDotfiles installation done.\e[0m\n"
